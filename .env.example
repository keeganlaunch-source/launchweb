# ---------------------------------------------------------------------------
# Launch Lifestyle - environment variables
# Copy the real values from the Replit Secrets export you were given.
# On Vercel: Project > Settings > Environment Variables > paste the whole
# KEY=value list into the form (it parses .env format) > Save > redeploy.
# ---------------------------------------------------------------------------

# --- Required to boot -------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # Neon/Vercel Postgres or any Postgres
OPENAI_API_KEY=sk-...                                        # Launch AI chat (app crashes on boot without it)
SESSION_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-long-random-string          # Vercel Cron auth for /api/cron/*
PUBLIC_BASE_URL=https://launchfit.app                        # used in email links

# --- Payments ---------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY_LIVE=
PAYSTACK_PUBLIC_KEY_LIVE=
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
SENDGRID_API_KEY=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_API_KEY=
DISABLE_ALL_EMAILS=false        # set to true to silence every outbound email (safe while testing)

# --- Google / Firebase / YouTube --------------------------------------------
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
VITE_GA_MEASUREMENT_ID=
GOOGLE_ANALYTICS_API_KEY=
GOOGLE_BUSINESS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=  # paste the FULL JSON of the Firebase service account on ONE line
YOUTUBE_API_KEY=

# --- Social / integrations (optional, dashboards only) ----------------------
META_ACCESS_TOKEN=
META_BUSINESS_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
SUDOR_API_KEY=
APP_STORE_CONNECT_KEY=
